{
  "name": "ai-interview-assistant",
  "version": "1.0.0",
  "description": "AI technical interview practice gym and mock interview coaching desktop application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && vite",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint electron/ src/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/verify-no-secrets.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "eslint": "^10.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.interview.assistant",
    "productName": "AI-Interview-Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "node_modules/pdfjs-dist/cmaps",
        "to": "cmaps"
      },
      {
        "from": "node_modules/pdfjs-dist/standard_fonts",
        "to": "standard_fonts"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Abhishek Singh"
    }
  },
  "author": "Abhishek Singh <Abhisheksingh1thakur@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhitvg/IAC.git"
  },
  "keywords": [
    "interview-practice",
    "technical-interview",
    "mock-interview",
    "ai-coach",
    "leetcode",
    "system-design",
    "behavioral-interview",
    "speech-coaching",
    "electron",
    "react",
    "typescript"
  ]
}
