{
  "manifest_version": 3,
  "name": "AI Interview Assistant - Browser Context",
  "version": "1.0.0",
  "description": "Send selected text and page context to your local AI Interview Assistant.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/index.html"
  }
}