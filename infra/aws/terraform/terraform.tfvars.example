aws_region            = "ap-southeast-2"
aws_account_id        = "165328640460"
project               = "careerops"
environment           = "production"
vpc_id                = "vpc-REPLACE"
public_subnet_ids     = ["subnet-PUBLIC_A", "subnet-PUBLIC_B"]
private_subnet_ids    = ["subnet-PRIVATE_A", "subnet-PRIVATE_B"]
database_subnet_ids   = ["subnet-DB_A", "subnet-DB_B"]
acm_certificate_arn   = "arn:aws:acm:ap-southeast-2:165328640460:certificate/REPLACE"
kms_key_arn           = "arn:aws:kms:ap-southeast-2:165328640460:key/REPLACE_WITH_EXISTING_KEY_ID"
container_image       = "165328640460.dkr.ecr.ap-southeast-2.amazonaws.com/careerops-production:release-bootstrap"
app_secrets_arn       = "arn:aws:secretsmanager:ap-southeast-2:165328640460:secret:careerops-production-config-REPLACE"
db_master_username    = "careerops_admin"
db_master_password    = "SET_OUTSIDE_VERSION_CONTROL"
db_instance_class     = "db.t4g.medium"
db_allocated_storage  = 50
api_desired_count     = 2
api_max_count         = 4
api_cpu               = 512
api_memory            = 1024
log_retention_days    = 30
db_backup_retention_days = 7
deletion_protection   = true
