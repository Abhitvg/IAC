aws_region               = "ap-southeast-2"
aws_account_id           = "165328640460"
project                  = "careerops"
environment              = "staging"
enable_https             = true
acm_certificate_arn      = "arn:aws:acm:ap-southeast-2:165328640460:certificate/9470a63a-647e-4f35-b32e-165b3d5e27fc"
vpc_id                   = "vpc-0bc0cb5d78fb32a15"
public_subnet_ids        = ["subnet-06d11260177d2cc26", "subnet-0442bc7a85c52a118"]
private_subnet_ids       = ["subnet-094d092843afe015e", "subnet-0d1956f455dd5e05d"]
private_route_table_ids  = ["rtb-024d3e164c8789f0a", "rtb-06cc31d3e822913e8"]

# REQUIRED: replace with two real, dedicated DB subnets in separate AZs.
# These must not be either application private subnet above. Their route
# tables must have no default route to an Internet Gateway or NAT Gateway.
database_subnet_ids      = ["subnet-REPLACE_WITH_DB_AZ_A", "subnet-REPLACE_WITH_DB_AZ_B"]

allowed_ingress_cidrs    = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
kms_key_arn              = "arn:aws:kms:ap-southeast-2:165328640460:key/9dffb4cb-6a4a-40e7-b49e-40415ddb9bf7"
container_image          = "165328640460.dkr.ecr.ap-southeast-2.amazonaws.com/careerops-staging:release-bootstrap"
app_secrets_arn          = "arn:aws:secretsmanager:ap-southeast-2:165328640460:secret:careerops-staging-config-REPLACE"
db_master_username       = "careerops_admin"
db_instance_class        = "db.t4g.medium"
db_allocated_storage     = 50
api_desired_count        = 2
api_max_count            = 4
api_cpu                  = 512
api_memory               = 1024
log_retention_days       = 30
db_backup_retention_days = 7
deletion_protection      = true
