aws_region            = "ap-south-1"
project               = "careerops"
environment           = "production"
vpc_id                = "vpc-REPLACE"
public_subnet_ids     = ["subnet-PUBLIC_A", "subnet-PUBLIC_B"]
private_subnet_ids    = ["subnet-PRIVATE_A", "subnet-PRIVATE_B"]
database_subnet_ids   = ["subnet-DB_A", "subnet-DB_B"]
acm_certificate_arn   = "arn:aws:acm:ap-south-1:ACCOUNT:certificate/REPLACE"
container_image       = "ACCOUNT.dkr.ecr.ap-south-1.amazonaws.com/careerops-production:release-bootstrap"
app_secrets_arn       = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:careerops-production-config-REPLACE"
db_master_username    = "careerops_admin"
db_master_password    = "SET_OUTSIDE_VERSION_CONTROL"
db_instance_class     = "db.t4g.medium"
db_allocated_storage  = 100
api_desired_count     = 2
api_cpu               = 512
api_memory            = 1024
deletion_protection   = true
