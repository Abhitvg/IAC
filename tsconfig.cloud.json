  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/cloud-core/src/**/*.ts",
    "tests/cloud-foundation.test.ts",
    "tests/cloud-migrations.test.ts",
    "tests/career-graph.test.ts",
    "tests/postgres-pool.test.ts",
    "tests/career-graph-api.test.ts",
    "tests/encryption.test.ts"
  ]
}
